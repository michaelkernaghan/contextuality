/-
Minimum sizes of Kochen-Specker sets inside named pools, checked by the kernel.

Claim proved for a pool `P` (an explicit list of vectors in ℂ³) and a number `u`:
  * some `u` of the vectors are KS-uncolourable, and
  * every set of fewer than `u` of the vectors has a KS colouring.

Certificate, written by `ks_lean_export.py minimality`, none of it trusted:
  * `fam`: colourable sets, each a pair of bit masks `(C, T)` — the complement of the set
    and the rays coloured `true`; the kernel checks every colouring (`colOK`).
    Any uncolourable set must meet every complement `C`.
  * `tree`: a branching proof that no set of fewer than `u` rays meets every `C`.  A node
    splits on one ray (in / out).  A leaf lists complements that miss the included rays and
    are pairwise disjoint once the excluded rays are removed: a hitting set needs a separate
    ray for each, so it has at least (included) + (listed) rays.

`min_index` is the soundness theorem at the level of indices; `colorable_of_index` and
`minimum_eq` carry it to vectors.  For the second half Lean must know EVERY orthogonal
pair, so each coefficient ring needs `Orthogonal (vec u) (vec v) → orthB u v = true`
(injectivity of the map to ℂ), the converse of what uncolourability needed.

What is not proved here: that the listed vectors are all the rays with coordinates in the
alphabet.  The pool is the explicit list.
-/
import NamedSets

open scoped BigOperators

namespace KSMin

open KSCyclotomic KSNamed
open KSCyclotomic.Eis (Sys Cert check)

/-! ### Index level -/

/-- `f` colours the rays of `J` validly. -/
def ValidOn (Q : Sys) (J : Finset Nat) (f : Nat → Bool) : Prop :=
  (∀ i ∈ J, ∀ j ∈ J, Q.orth i j = true → ¬ (f i = true ∧ f j = true)) ∧
  (∀ i ∈ J, ∀ j ∈ J, ∀ k ∈ J, Q.orth i j = true → Q.orth i k = true → Q.orth j k = true →
      f i = true ∨ f j = true ∨ f k = true)

/-- A binary tree of colourable sets.  A leaf `(C, T)` is a pair of bit masks: `C` the
complement of the set, `T` the rays coloured `true`. -/
inductive BT where
  | leaf (C T : Nat)
  | node (l r : BT)

def BT.get : BT → Nat → Nat × Nat
  | .leaf C T, _ => (C, T)
  | .node l r, j => if j % 2 = 0 then l.get (j / 2) else r.get (j / 2)

def BT.all (p : Nat → Nat → Bool) : BT → Bool
  | .leaf C T => p C T
  | .node l r => l.all p && r.all p

/-- `(C, T)` is a leaf. -/
inductive BT.Mem (C T : Nat) : BT → Prop
  | leaf : BT.Mem C T (.leaf C T)
  | left {l r} : BT.Mem C T l → BT.Mem C T (.node l r)
  | right {l r} : BT.Mem C T r → BT.Mem C T (.node l r)

theorem BT.get_mem (t : BT) : ∀ j, BT.Mem (t.get j).1 (t.get j).2 t := by
  induction t with
  | leaf C T => intro j; exact .leaf
  | node l r ihl ihr =>
    intro j
    by_cases h : j % 2 = 0
    · simp only [BT.get, h, if_true]; exact .left (ihl _)
    · simp only [BT.get, h, if_false]; exact .right (ihr _)

theorem BT.all_mem {p : Nat → Nat → Bool} {t : BT} (h : t.all p = true) {C T : Nat}
    (hm : BT.Mem C T t) : p C T = true := by
  induction hm with
  | leaf => exact h
  | left _ ih => simp only [BT.all, Bool.and_eq_true] at h; exact ih h.1
  | right _ ih => simp only [BT.all, Bool.and_eq_true] at h; exact ih h.2

/-- The data of a pool: its orthogonal pairs `i < j` and triads `i < j < k`. -/
structure Pool where
  Q : Sys
  pairs : List (Nat × Nat)
  triads : List (Nat × Nat × Nat)

def rangeAll (n : Nat) (p : Nat → Bool) : Bool := (List.range n).all p

theorem rangeAll_iff {n : Nat} {p : Nat → Bool} :
    rangeAll n p = true ↔ ∀ i, i < n → p i = true := by
  simp [rangeAll, List.all_eq_true]

/-- `orth` is symmetric and irreflexive; the pair and triad lists are complete. -/
def Pool.ok (P : Pool) : Bool :=
  rangeAll P.Q.n fun i =>
    !P.Q.orth i i &&
    rangeAll P.Q.n fun j =>
      (P.Q.orth i j == P.Q.orth j i) &&
      (!P.Q.orth i j || !decide (i < j) ||
        (P.pairs.contains (i, j) &&
          rangeAll P.Q.n fun k =>
            !decide (j < k) || !P.Q.orth i k || !P.Q.orth j k || P.triads.contains (i, j, k)))

/-- `T` colours the set with complement `C` validly. -/
def colOK (P : Pool) (C T : Nat) : Bool :=
  (P.pairs.all fun p => !(T.testBit p.1 && T.testBit p.2)) &&
  (P.triads.all fun t =>
    C.testBit t.1 || C.testBit t.2.1 || C.testBit t.2.2 ||
    T.testBit t.1 || T.testBit t.2.1 || T.testBit t.2.2)

/-- A lower-bound tree for hitting sets. -/
inductive LB where
  | pack (js : List Nat)
  | dead (j : Nat)
  | split (v : Nat) (a b : LB)

/-- The clauses `js` miss `I` and are pairwise disjoint once `E` is removed. -/
def packOK (fam : BT) (I E : Nat) : List Nat → Nat → Bool
  | [], _ => true
  | j :: js, acc =>
    let c := (fam.get j).1
    let d := c ^^^ (c &&& E)
    (c &&& I == 0) && (d &&& acc == 0) && packOK fam I E js (acc ||| d)

def checkLB (fam : BT) (u : Nat) : Nat → Nat → Nat → LB → Bool
  | I, E, k, .pack js => decide (u ≤ k + js.length) && packOK fam I E js 0
  | _, E, _, .dead j => (fam.get j).1 ^^^ ((fam.get j).1 &&& E) == 0
  | I, E, k, .split v a b =>
    !I.testBit v && checkLB fam u (I ||| 2 ^ v) E (k + 1) a && checkLB fam u I (E ||| 2 ^ v) k b

theorem testBit_of_and_eq_zero {a b x : Nat} (h : a &&& b = 0) (ha : a.testBit x = true) :
    b.testBit x = false := by
  have := congrArg (fun m => Nat.testBit m x) h
  simp only [Nat.testBit_and, Nat.zero_testBit, ha, Bool.true_and] at this
  exact this

/-- `S` meets the complement of every colourable set of the family. -/
def Hits (fam : BT) (S : Finset Nat) : Prop :=
  ∀ C T, BT.Mem C T fam → ∃ v ∈ S, C.testBit v = true

theorem pack_sound (fam : BT) (I E : Nat) (S A : Finset Nat)
    (hI : ∀ v, I.testBit v = true ↔ v ∈ A)
    (hE : ∀ v ∈ S, E.testBit v = false) (hS : Hits fam S) :
    ∀ (js : List Nat) (acc : Nat) (B : Finset Nat), packOK fam I E js acc = true →
      B ⊆ S → Disjoint A B → (∀ w ∈ B, acc.testBit w = true) →
      ∃ B' : Finset Nat, B' ⊆ S ∧ Disjoint A B' ∧ B'.card = B.card + js.length := by
  intro js
  induction js with
  | nil => intro acc B _ hB hd _; exact ⟨B, hB, hd, by simp⟩
  | cons j js ih =>
    intro acc B h hB hd hacc
    simp only [packOK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨hcI, hdacc⟩, hrest⟩ := h
    obtain ⟨x, hxS, hxc⟩ := hS _ _ (fam.get_mem j)
    have hxE := hE x hxS
    have hxd : ((fam.get j).1 ^^^ ((fam.get j).1 &&& E)).testBit x = true := by
      simp [Nat.testBit_xor, Nat.testBit_and, hxc, hxE]
    have hxA : x ∉ A := by
      intro hx
      have := testBit_of_and_eq_zero hcI hxc
      rw [(hI x).mpr hx] at this
      cases this
    have hxB : x ∉ B := by
      intro hx
      have := testBit_of_and_eq_zero hdacc hxd
      rw [hacc x hx] at this
      cases this
    obtain ⟨B', h1, h2, h3⟩ := ih (acc ||| ((fam.get j).1 ^^^ ((fam.get j).1 &&& E)))
      (insert x B) hrest
      (by intro y hy; rcases Finset.mem_insert.mp hy with rfl | hy; exacts [hxS, hB hy])
      (by
        rw [Finset.disjoint_insert_right]
        exact ⟨hxA, hd⟩)
      (by
        intro w hw
        rcases Finset.mem_insert.mp hw with rfl | hw
        · simp [Nat.testBit_or, hxd]
        · simp [Nat.testBit_or, hacc w hw])
    refine ⟨B', h1, h2, ?_⟩
    rw [h3, Finset.card_insert_of_notMem hxB, List.length_cons]
    omega

theorem LB_sound (fam : BT) (u : Nat) (S : Finset Nat) (hS : Hits fam S) :
    ∀ (t : LB) (I E k : Nat) (A : Finset Nat), checkLB fam u I E k t = true →
      (∀ v, I.testBit v = true ↔ v ∈ A) → A.card = k → A ⊆ S →
      (∀ v ∈ S, E.testBit v = false) → u ≤ S.card := by
  intro t
  induction t with
  | pack js =>
    intro I E k A h hI hk hAS hE
    simp only [checkLB, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨B', h1, h2, h3⟩ := pack_sound fam I E S A hI hE hS js 0 ∅ h.2
      (Finset.empty_subset _) (Finset.disjoint_empty_right _) (by simp)
    have : (A ∪ B').card ≤ S.card := Finset.card_le_card (Finset.union_subset hAS h1)
    rw [Finset.card_union_of_disjoint h2, h3, hk] at this
    simp at this
    omega
  | dead j =>
    intro I E k A h _ _ _ hE
    simp only [checkLB, beq_iff_eq] at h
    obtain ⟨x, hxS, hxc⟩ := hS _ _ (fam.get_mem j)
    have hxd : ((fam.get j).1 ^^^ ((fam.get j).1 &&& E)).testBit x = true := by
      simp [Nat.testBit_xor, Nat.testBit_and, hxc, hE x hxS]
    rw [h, Nat.zero_testBit] at hxd
    cases hxd
  | split v a b iha ihb =>
    intro I E k A h hI hk hAS hE
    simp only [checkLB, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨⟨hv, ha⟩, hb⟩ := h
    have hvA : v ∉ A := fun hx => by rw [(hI v).mpr hx] at hv; cases hv
    by_cases hvS : v ∈ S
    · refine iha (I ||| 2 ^ v) E (k + 1) (insert v A) ha ?_ ?_ ?_ hE
      · intro w
        rw [Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, hI w, Finset.mem_insert,
          decide_eq_true_eq]
        constructor
        · rintro (h | h); exacts [Or.inr h, Or.inl h.symm]
        · rintro (h | h); exacts [Or.inr h.symm, Or.inl h]
      · rw [Finset.card_insert_of_notMem hvA, hk]
      · intro y hy; rcases Finset.mem_insert.mp hy with rfl | hy; exacts [hvS, hAS hy]
    · refine ihb I (E ||| 2 ^ v) k A hb hI hk hAS ?_
      intro w hw
      rw [Nat.testBit_or, Nat.testBit_two_pow, hE w hw, Bool.false_or, decide_eq_false_iff_not]
      rintro rfl; exact hvS hw

/-- **Index-level minimality.**  If every leaf of `fam` is a valid colouring of its set and
the tree `t` checks, then every set of fewer than `u` rays has a valid colouring. -/
theorem min_index (P : Pool) (fam : BT) (u : Nat) (t : LB)
    (hP : P.ok = true) (hfam : fam.all (colOK P) = true)
    (ht : checkLB fam u 0 0 0 t = true)
    (J : Finset Nat) (hJ : ∀ v ∈ J, v < P.Q.n) (hcard : J.card < u) :
    ∃ f, ValidOn P.Q J f := by
  have hnot : ¬ Hits fam J := fun hS => by
    have := LB_sound fam u J hS t 0 0 0 ∅ ht (by simp) rfl (Finset.empty_subset _) (by simp)
    omega
  unfold Hits at hnot
  push Not at hnot
  obtain ⟨C, T, hm, hC⟩ := hnot
  have hCf : ∀ v ∈ J, C.testBit v = false := fun v hv => by simpa using hC v hv
  have hcol := BT.all_mem hfam hm
  simp only [colOK, Bool.and_eq_true, List.all_eq_true] at hcol
  obtain ⟨hpairs, htri⟩ := hcol
  -- unpack the pool check
  have hok : ∀ i, i < P.Q.n → P.Q.orth i i = false ∧ ∀ j, j < P.Q.n →
      P.Q.orth i j = P.Q.orth j i ∧ (P.Q.orth i j = true → i < j →
        (i, j) ∈ P.pairs ∧ ∀ k, k < P.Q.n → j < k → P.Q.orth i k = true →
          P.Q.orth j k = true → (i, j, k) ∈ P.triads) := by
    intro i hi
    have h1 := rangeAll_iff.mp hP i hi
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at h1
    refine ⟨h1.1, fun j hj => ?_⟩
    have h2 := rangeAll_iff.mp h1.2 j hj
    simp only [Bool.and_eq_true, beq_iff_eq, Bool.or_eq_true, Bool.not_eq_true',
      decide_eq_false_iff_not, List.contains_iff_mem] at h2
    refine ⟨h2.1, fun ho hlt => ?_⟩
    rcases h2.2 with (h | h) | h
    · rw [ho] at h; cases h
    · exact absurd hlt h
    · refine ⟨h.1, fun k hk hjk oik ojk => ?_⟩
      have h3 := rangeAll_iff.mp h.2 k hk
      simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not,
        List.contains_iff_mem] at h3
      rcases h3 with ((h | h) | h) | h
      · exact absurd hjk h
      · rw [oik] at h; cases h
      · rw [ojk] at h; cases h
      · exact h
  have sym : ∀ i j, i < P.Q.n → j < P.Q.n → P.Q.orth i j = true → P.Q.orth j i = true :=
    fun i j hi hj h => by rw [← ((hok i hi).2 j hj).1]; exact h
  -- pairs: not both true
  have pair_lt : ∀ i j, i < P.Q.n → j < P.Q.n → i < j → P.Q.orth i j = true →
      ¬ (T.testBit i = true ∧ T.testBit j = true) := by
    intro i j hi hj hlt ho ⟨ti, tj⟩
    have := hpairs _ (((hok i hi).2 j hj).2 ho hlt).1
    simp [ti, tj] at this
  -- sorted triads: one true
  have tri_lt : ∀ i j k, i ∈ J → j ∈ J → k ∈ J → i < j → j < k → P.Q.orth i j = true →
      P.Q.orth i k = true → P.Q.orth j k = true →
      T.testBit i = true ∨ T.testBit j = true ∨ T.testBit k = true := by
    intro i j k hi hj hk hij hjk oij oik ojk
    have hmem := (((hok i (hJ i hi)).2 j (hJ j hj)).2 oij hij).2 k (hJ k hk) hjk oik ojk
    have := htri _ hmem
    simp only [hCf i hi, hCf j hj, hCf k hk, Bool.false_or, Bool.or_eq_true] at this
    tauto
  refine ⟨fun v => T.testBit v, ?_, ?_⟩
  · intro i hi j hj ho
    have hne : i ≠ j := by
      rintro rfl; rw [(hok i (hJ i hi)).1] at ho; cases ho
    rcases lt_or_gt_of_ne hne with h | h
    · exact pair_lt i j (hJ i hi) (hJ j hj) h ho
    · intro ⟨a, b⟩
      exact pair_lt j i (hJ j hj) (hJ i hi) h (sym i j (hJ i hi) (hJ j hj) ho) ⟨b, a⟩
  · intro i hi j hj k hk oij oik ojk
    have hi' := hJ i hi
    have hj' := hJ j hj
    have hk' := hJ k hk
    have nij : i ≠ j := by rintro rfl; rw [(hok i hi').1] at oij; cases oij
    have nik : i ≠ k := by rintro rfl; rw [(hok i hi').1] at oik; cases oik
    have njk : j ≠ k := by rintro rfl; rw [(hok j hj').1] at ojk; cases ojk
    have oji := sym i j hi' hj' oij
    have oki := sym i k hi' hk' oik
    have okj := sym j k hj' hk' ojk
    rcases lt_or_gt_of_ne nij with a | a <;> rcases lt_or_gt_of_ne nik with b | b <;>
      rcases lt_or_gt_of_ne njk with c | c
    · exact tri_lt i j k hi hj hk a c oij oik ojk
    · have := tri_lt i k j hi hk hj b c oik oij okj; tauto
    · omega
    · have := tri_lt k i j hk hi hj b a oki okj oij; tauto
    · have := tri_lt j i k hj hi hk a b oji ojk oik; tauto
    · omega
    · have := tri_lt j k i hj hk hi c b ojk oji oki; tauto
    · have := tri_lt k j i hk hj hi c a okj oki oji; tauto

/-! ### Bridge to vectors in `ℂ³` -/

/-- If every genuine orthogonality among the vectors is recorded in `Q.orth`, the vectors
are distinct, and `Q` has a valid colouring on every index set of fewer than `u` rays, then
every set of fewer than `u` of the vectors has a Kochen-Specker colouring. -/
theorem colorable_of_index (Q : Sys) (vecs : Nat → (Fin 3 → ℂ)) (u : Nat)
    (hexact : ∀ i j, i < Q.n → j < Q.n → Orthogonal (vecs i) (vecs j) → Q.orth i j = true)
    (hinj : ∀ i j, i < Q.n → j < Q.n → vecs i = vecs j → i = j)
    (hidx : ∀ J : Finset Nat, (∀ v ∈ J, v < Q.n) → J.card < u → ∃ f, ValidOn Q J f)
    (T : Set (Fin 3 → ℂ)) (hT : T ⊆ vset Q.n vecs) (hcard : T.ncard < u) :
    ¬ KSUncolorable T := by
  classical
  have hfin : (vset Q.n vecs).Finite := by
    have : vset Q.n vecs = vecs '' (↑(Finset.range Q.n) : Set Nat) := by
      ext v; simp [vset, eq_comm]
    rw [this]; exact (Finset.finite_toSet _).image _
  have hTfin : T.Finite := hfin.subset hT
  set J : Finset Nat := (Finset.range Q.n).filter (fun i => vecs i ∈ T) with hJdef
  have hJlt : ∀ v ∈ J, v < Q.n := fun v hv => Finset.mem_range.mp (Finset.mem_filter.mp hv).1
  have hJT : ∀ v ∈ J, vecs v ∈ T := fun v hv => (Finset.mem_filter.mp hv).2
  have hJcard : J.card ≤ T.ncard := by
    rw [Set.ncard_eq_toFinset_card T hTfin]
    refine Finset.card_le_card_of_injOn vecs ?_ ?_
    · intro v hv; simpa using hJT v hv
    · intro a ha b hb h
      exact hinj a b (hJlt a ha) (hJlt b hb) h
  obtain ⟨f, hf1, hf2⟩ := hidx J hJlt (lt_of_le_of_lt hJcard hcard)
  have idx : ∀ v ∈ T, ∃ i ∈ J, vecs i = v := by
    intro v hv
    obtain ⟨i, hi, rfl⟩ := hT hv
    exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hi, hv⟩, rfl⟩
  let c : (Fin 3 → ℂ) → Bool := fun v => decide (∃ i ∈ J, vecs i = v ∧ f i = true)
  have hc : ∀ i ∈ J, c (vecs i) = f i := by
    intro i hi
    by_cases h : f i = true
    · rw [h]; exact decide_eq_true ⟨i, hi, rfl, h⟩
    · have hfalse : f i = false := by simpa using h
      rw [hfalse]
      refine decide_eq_false ?_
      rintro ⟨j, hj, hji, hfj⟩
      have := hinj j i (hJlt j hj) (hJlt i hi) hji
      subst this
      exact h hfj
  intro hun
  apply hun
  refine ⟨c, ?_, ?_⟩
  · intro v hv w hw hvw
    obtain ⟨i, hi, rfl⟩ := idx v hv
    obtain ⟨j, hj, rfl⟩ := idx w hw
    rw [hc i hi, hc j hj]
    exact hf1 i hi j hj (hexact i j (hJlt i hi) (hJlt j hj) hvw)
  · intro t ht
    obtain ⟨hsub, hcard3, horth⟩ := ht
    obtain ⟨a, b, d, hab, had, hbd, rfl⟩ := Finset.card_eq_three.mp hcard3
    have haT : a ∈ T := hsub (by simp)
    have hbT : b ∈ T := hsub (by simp)
    have hdT : d ∈ T := hsub (by simp)
    obtain ⟨i, hi, rfl⟩ := idx a haT
    obtain ⟨j, hj, rfl⟩ := idx b hbT
    obtain ⟨k, hk, rfl⟩ := idx d hdT
    have oij := hexact i j (hJlt i hi) (hJlt j hj) (horth _ (by simp) _ (by simp) hab)
    have oik := hexact i k (hJlt i hi) (hJlt k hk) (horth _ (by simp) _ (by simp) had)
    have ojk := hexact j k (hJlt j hj) (hJlt k hk) (horth _ (by simp) _ (by simp) hbd)
    have one := hf2 i hi j hj k hk oij oik ojk
    have nij := hf1 i hi j hj oij
    have nik := hf1 i hi k hk oik
    have njk := hf1 j hj k hk ojk
    rw [Finset.filter_insert, Finset.filter_insert, Finset.filter_singleton, hc i hi, hc j hj,
      hc k hk]
    rcases one with h | h | h
    · have h2 : f j = false := by
        cases hfj : f j with
        | false => rfl
        | true => exact absurd ⟨h, hfj⟩ nij
      have h3 : f k = false := by
        cases hfk : f k with
        | false => rfl
        | true => exact absurd ⟨h, hfk⟩ nik
      simp [h, h2, h3]
    · have h1 : f i = false := by
        cases hfi : f i with
        | false => rfl
        | true => exact absurd ⟨hfi, h⟩ nij
      have h3 : f k = false := by
        cases hfk : f k with
        | false => rfl
        | true => exact absurd ⟨h, hfk⟩ njk
      simp [h, h1, h3]
    · have h1 : f i = false := by
        cases hfi : f i with
        | false => rfl
        | true => exact absurd ⟨hfi, h⟩ nik
      have h2 : f j = false := by
        cases hfj : f j with
        | false => rfl
        | true => exact absurd ⟨hfj, h⟩ njk
      simp [h, h1, h2]

/-! ### A pool given by exact coordinates -/

section Model

variable {R : Type} [DecidableEq R] (orthB : R → R → Bool) (vec : R → (Fin 3 → ℂ)) (zero : R)

/-- The index system of a list of rays. -/
def sysOf (rays : List R) : Sys :=
  ⟨rays.length, fun i j => orthB (rays.getD i zero) (rays.getD j zero)⟩

/-- The index system of the rays picked out by `sel`. -/
def subSys (rays : List R) (sel : List Nat) : Sys :=
  ⟨sel.length, fun i j =>
    orthB (rays.getD (sel.getD i 0) zero) (rays.getD (sel.getD j 0) zero)⟩

/-- No vector is listed twice.  (Equality of coordinate tuples, not proportionality: that the
listed vectors are pairwise non-proportional is checked by the export script, not here, and is
